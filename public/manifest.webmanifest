{
  "name": "Two iPad Air Hockey",
  "short_name": "Air Hockey",
  "description": "Air hockey across two iPads laid top edge to top edge.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "portrait",
  "background_color": "#0b1020",
