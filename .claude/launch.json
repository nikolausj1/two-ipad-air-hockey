{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "air-hockey",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3000
    },
    {
      "name": "static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080",
        "--directory",
        "public"
      ],
      "port": 8080
    },
    {
      "name": "ideas",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8092",
        "--directory",
        "docs/ideas"
      ],
      "port": 8092
    }
  ]
}
